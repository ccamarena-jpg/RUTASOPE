# Copia este archivo como .env (para desarrollo local) y pon los valores reales.
# En Vercel, estos mismos se cargan en Project Settings > Environment Variables.

# Cuenta de servicio de Google (creada en Google Cloud, formato JSON).
GOOGLE_SERVICE_ACCOUNT_EMAIL=nombre@tu-proyecto.iam.gserviceaccount.com
# La clave privada del JSON. En una sola linea, con los saltos de linea como \n.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# ID de la hoja de calculo (esta en la URL: /spreadsheets/d/ESTE_ID/edit).
GOOGLE_SHEET_ID=

# ID de la carpeta de Google Drive donde se guardan las guias de remision
# (esta en la URL de la carpeta: /drive/folders/ESTE_ID). Opcional pero recomendado.
GOOGLE_DRIVE_FOLDER_ID=

# Clave para firmar los tokens de sesion. Pon una cadena larga y aleatoria.
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria

# Solo para desarrollo local:
PORT=4000
