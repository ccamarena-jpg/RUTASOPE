# Copia este archivo como .env.local (para desarrollo) o define la variable en
# Vercel (Project Settings > Environment Variables) para produccion.

# URL del Web App de Google Apps Script, terminada en /exec.
# La obtienes al implementar el script (Implementar > Nueva implementacion >
# Aplicacion web). Ver apps-script/README.md.
VITE_APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXXXXXX/exec

# ID de cliente OAuth de Google para "Iniciar sesion con Google" (personal
# TT Audit). Se crea una vez en la Consola de Google. Debe ser el MISMO que
# pongas en el backend (CONFIG.GOOGLE_CLIENT_ID en apps-script/Code.gs).
# Si lo dejas vacio, solo funcionara el login por correo + contrasena.
VITE_GOOGLE_CLIENT_ID=XXXXXXXX.apps.googleusercontent.com

# API key de Google Maps (Maps JavaScript API) para el "Mapa en vivo" de choferes.
# Se crea en la Consola de Google (requiere facturacion, tiene capa gratuita).
# Restringela por referrer HTTP (localhost + tu dominio de Vercel).
VITE_GOOGLE_MAPS_API_KEY=
